@model List<Category>
@if (!Model.Any())
{
<div class="alert alert-danger" role="alert">
    No Category Found
</div>

}
else
{
    <div class="card-body">
        <table class="table table-bordered" role="table">
            <thead>
                <tr>
                    <th style="width: 10px" scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Status</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in @Model)
                {

                
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>
                            <span class="badge rounded-pill text-bg-@(item.status == Ecommerce.Enums.CategoryStatus.Active?"success": "danger")"> @item.status</span>
     
                        </td>

                        <td>
                            <a asp-controller="Categories" asp-action="delete" asp-route-id="@item.Id" type="button" class="btn btn-danger mb-2">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}





