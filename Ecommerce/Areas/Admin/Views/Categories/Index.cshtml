@model List<Category>
@if (!Model.Any())
{
<div class="alert alert-danger" role="alert">
    No Category Found
</div>

}
else
{
    <div class="card-body">
        <table class="table table-bordered" role="table">
            <thead>
                <tr>
                    <th style="width: 10px" scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in @Model)
                {

                
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}





